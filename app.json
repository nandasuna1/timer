{
  "expo": {
    "name": "timer",
    "slug": "timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/timer3.jpg",
    "scheme": "timer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/timer3.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nandasunadev.timer",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/timer3.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "163e459c-ac86-4074-851f-5a9a8aedcd85"
      }
    }
  }
}
